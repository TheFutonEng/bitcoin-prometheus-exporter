# Which bitcoind configuration the stack mounts at /data/bitcoin.conf, and
# where that chain's cookie file lands inside the container. Change both
# together: bitcoind keeps mainnet's cookie at the data directory root and
# every other network's under a subdirectory named after it.
BITCOIN_CONF=./deploy/bitcoin/regtest.conf
BITCOIN_COOKIE=/data/regtest/.cookie

# Against signet instead:
#   BITCOIN_CONF=./deploy/bitcoin/signet.conf
#   BITCOIN_COOKIE=/data/signet/.cookie
#
# Against your own node configuration:
#   BITCOIN_CONF=./my-bitcoin.conf
#   BITCOIN_COOKIE=/data/<network>/.cookie
#
# Your file must select its own network, because the stack passes no -chain
# flag. It must also leave RPC reachable from the exporter container
# (rpcbind=0.0.0.0, rpcallowip, rpcport=8332) or the exporter cannot connect.
